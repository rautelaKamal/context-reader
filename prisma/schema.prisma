// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  annotations   Annotation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Annotation {
  id            String       @id @default(cuid())
  text          String
  explanation   String
  translation   String?
  url           String
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// The annotation history feature this models is not built yet, so the Prisma
// client is not a dependency: an unused import of it failed the production
// build on a clean install. The schema stays because the design is the useful
// part. To pick it up again:
//
//   npm install prisma @prisma/client && npx prisma generate
