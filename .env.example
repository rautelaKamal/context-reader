# Pick one provider. All of these speak the same OpenAI-compatible API, so only
# these three values change - no code change.

# Google Gemini - free, no credit card. Key: https://aistudio.google.com/apikey
# flash-lite answers in under 2s; the full flash models spend 15-30s thinking,
# which is far too slow for something you use mid-sentence while reading.
PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PROVIDER_API_KEY=
EXPLAIN_MODEL=gemini-3.5-flash-lite

# Groq - free, also fast. Key: https://console.groq.com/keys
# PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# PROVIDER_API_KEY=
# EXPLAIN_MODEL=llama-3.3-70b-versatile

# Hugging Face - only $0.10/month of free credits, not enough for real use.
# PROVIDER_BASE_URL=https://router.huggingface.co/v1
# HUGGING_FACE_API_KEY=
# EXPLAIN_MODEL=Qwen/Qwen2.5-72B-Instruct

# ---------------------------------------------------------------------------
# Quota store. Upstash Redis, free tier: https://console.upstash.com
# Create a database, then copy the two REST values from its dashboard.
#
# Leave these blank and the API still works, but nothing is enforced: the
# counters are skipped and every request is allowed. Set them before relying
# on the limits below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Daily limits, counted in cost units. A fast explanation costs 1, a deep
# read costs 3. All optional; the defaults are shown.
# DAILY_PER_INSTALL=30
# DAILY_PER_IP=90
# DAILY_GLOBAL_BUDGET=2000

# Moves the day boundary off UTC, in minutes, so counters reset at the
# audience's midnight rather than at 05:30 their time. 330 is India.
# QUOTA_DAY_OFFSET_MINUTES=330

# Extension ids allowed to call the API, comma separated. The published id is
# always allowed without being listed here; this is for an unpacked dev build.
# ALLOWED_EXTENSION_IDS=
