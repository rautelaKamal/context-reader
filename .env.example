# Pick one provider. All of these speak the same OpenAI-compatible API, so only
# these three values change - no code change.

# Google Gemini - free, no credit card. Key: https://aistudio.google.com/apikey
# flash-lite answers in under 2s; the full flash models spend 15-30s thinking,
# which is far too slow for something you use mid-sentence while reading.
PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PROVIDER_API_KEY=
EXPLAIN_MODEL=gemini-3.5-flash-lite

# Groq - free, also fast. Key: https://console.groq.com/keys
# PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# PROVIDER_API_KEY=
# EXPLAIN_MODEL=llama-3.3-70b-versatile

# Hugging Face - only $0.10/month of free credits, not enough for real use.
# PROVIDER_BASE_URL=https://router.huggingface.co/v1
# HUGGING_FACE_API_KEY=
# EXPLAIN_MODEL=Qwen/Qwen2.5-72B-Instruct
